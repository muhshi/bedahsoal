# ==========================================
# BEDAHSOAL Platform - Environment Configuration
# Multi-Exam CBT (SKD CPNS, LPDP, Olimpiade, UTBK)
# ==========================================

# Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://bpsdemak:demak3321@10.133.21.24:5433/cat_skd_db?schema=public"

# NextAuth / Auth.js v5
# Untuk server production: NEXTAUTH_URL="http://10.133.21.24:3001"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="bedahsoal-super-secret-jwt-key-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="bedahsoal-super-secret-jwt-key-min-32-chars-long"

# Google OAuth 2.0 Credentials (dari Google Cloud Console)
# Authorized JavaScript origins:
#   http://10.133.21.24:3001
#   http://localhost:3000
#   http://localhost:3001
# Authorized redirect URIs:
#   http://10.133.21.24:3001/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Magic Link (Resend or SMTP)
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="your-resend-api-key"
EMAIL_FROM="noreply@bedahsoal.id"

# Duitku Payment Gateway
DUITKU_MERCHANT_CODE="your_merchant_code"
DUITKU_API_KEY="your_duitku_api_key"
DUITKU_ENV="sandbox" # sandbox | production
DUITKU_CALLBACK_URL="http://localhost:3000/api/duitku/callback"
DUITKU_RETURN_URL="http://localhost:3000/dashboard"

# S3 / Cloudflare R2 Object Storage (Figural images)
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="your_r2_access_key"
STORAGE_SECRET_ACCESS_KEY="your_r2_secret_key"
STORAGE_BUCKET_NAME="bedahsoal-media"
STORAGE_PUBLIC_URL="https://media.bedahsoal.id"
